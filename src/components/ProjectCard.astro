---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const ledClass = project.status === 'open source' ? 'led led--amber' : 'led';
---

<article class="panel panel-hover reveal flex h-full flex-col p-5 sm:p-6">
  <header class="mb-3 flex items-center justify-between gap-3">
    <h3 class="display text-xl text-text">{project.title}</h3>
    <span class="inline-flex flex-none items-center gap-2 font-mono text-[0.7rem] uppercase tracking-wider text-muted">
      <span class={ledClass} aria-hidden="true"></span>
      {project.status}
    </span>
  </header>

  <p class="mb-5 text-sm leading-relaxed text-muted">{project.description}</p>

  {
    project.archi && (
      <div class="archi mb-5" aria-label="Architecture du projet">
        {project.archi.map((node, i) => (
          <>
            {i > 0 && <span class="archi-link" aria-hidden="true" />}
            <span class="archi-node">{node}</span>
          </>
        ))}
      </div>
    )
  }

  <ul class="mb-5 flex flex-wrap gap-1.5">
    {project.stack.map((tech) => <li class="tag">{tech}</li>)}
  </ul>

  <footer class="mt-auto flex flex-wrap gap-4 border-t border-line/60 pt-4 font-mono text-sm">
    {
      project.demo && (
        <a
          href={project.demo}
          rel="noopener"
          class="text-accent transition-colors hover:text-text"
        >
          voir le site ↗
        </a>
      )
    }
    {
      project.repo && (
        <a
          href={project.repo}
          rel="noopener"
          class="text-cable transition-colors hover:text-text"
        >
          code source ↗
        </a>
      )
    }
    {
      !project.demo && !project.repo && (
        <span class="text-muted">dépôt privé (client)</span>
      )
    }
  </footer>
</article>

---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<Section
  id="projets"
  eyebrow="systemctl status — tous services actifs"
  title="Services en production"
>
  <p class="reveal -mt-6 mb-10 max-w-2xl text-muted sm:text-lg">
    Pas des démos : des applications livrées à de vrais clients, utilisées tous
    les jours sur le terrain. Chaque carte montre le chemin que suit une requête.
  </p>

  <div class="grid gap-5 md:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Section>

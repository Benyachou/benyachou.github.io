---
import Section from './Section.astro';
import { education } from '../data/education';
---

<Section id="formation" eyebrow="diplômes installés" title="Formation">
  <div class="grid gap-5 md:grid-cols-3">
    {
      education.map((item) => (
        <div class="panel panel-hover reveal p-5">
          <p class="mb-2 flex items-center justify-between font-mono text-sm">
            <span class="text-accent">{item.period}</span>
            {item.note && <span class="text-led">✓ {item.note.toLowerCase()}</span>}
          </p>
          <h3 class="mb-1 font-semibold text-text">{item.title}</h3>
          <p class="text-sm text-muted">{item.school}</p>
        </div>
      ))
    }
  </div>
</Section>

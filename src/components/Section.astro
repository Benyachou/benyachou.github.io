---
/**
 * Conteneur de section : chaque section est un « segment » du schéma,
 * raccordé au rail vertical (bus) qui court le long de la page.
 */
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="bus py-16 sm:py-24 lg:pl-10">
      <header class="reveal mb-10 sm:mb-14">
        {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
        <h2 class="display text-3xl text-text sm:text-4xl lg:text-5xl">
          {title}
        </h2>
      </header>
      <slot />
    </div>
  </div>
</section>

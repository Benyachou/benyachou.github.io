---
import Section from './Section.astro';
import { site } from '../data/site';
import { withBase } from '../lib/path';

const cvHref = withBase(site.cvPath);

const channels = [
  {
    label: 'e-mail',
    value: site.email,
    href: `mailto:${site.email}`,
    hint: 'réponse sous 24 h',
  },
  {
    label: 'téléphone',
    value: site.phone,
    href: `tel:+33${site.phone.replaceAll(' ', '').slice(1)}`,
    hint: 'Montpellier et alentours',
  },
  {
    label: 'github',
    value: `github.com/${site.github}`,
    href: site.githubUrl,
    hint: 'le code parle',
  },
  {
    label: 'linkedin',
    value: 'in/benyachou',
    href: site.linkedinUrl,
    hint: 'profil pro',
  },
];
---

<Section id="contact" eyebrow="ping — hôte joignable" title="Établir la connexion">
  <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:gap-12">
    <div class="reveal">
      <p class="max-w-md text-muted sm:text-lg">
        Un poste de technicien systèmes &amp; réseaux, une application à
        construire, ou les deux : je suis basé à {site.location}, mobile et
        disponible.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={`mailto:${site.email}`} class="btn-primary">M’écrire</a>
        <a href={cvHref} class="btn-ghost">Télécharger le CV</a>
      </div>
      <p class="mt-7 font-mono text-xs text-muted">
        <span class="text-led">64 bytes</span> from yassine-benyachou: icmp_seq=1
        time=<span class="text-led">0.4 ms</span> — <span class="inline-flex items-center gap-1.5"><span class="led" aria-hidden="true"></span> disponible</span>
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        channels.map((c) => (
          <a
            href={c.href}
            rel="noopener"
            class="panel panel-hover reveal block p-5"
          >
            <p class="mb-1.5 font-mono text-[0.7rem] uppercase tracking-widest text-cable">
              {c.label}
            </p>
            <p class="break-all font-mono text-sm text-text">{c.value}</p>
            <p class="mt-1.5 text-xs text-muted">{c.hint}</p>
          </a>
        ))
      }
    </div>
  </div>
</Section>

---
import Section from './Section.astro';
import { skillGroups } from '../data/skills';
---

<Section
  id="competences"
  eyebrow="show vlan brief"
  title="Compétences, segmentées par VLAN"
>
  <p class="reveal -mt-6 mb-10 max-w-2xl text-muted sm:text-lg">
    Comme un réseau bien administré : chaque domaine dans son segment, avec sa
    provenance — pratiqué en entreprise, ou monté au BTS et sur mon laboratoire
    personnel.
  </p>

  <div class="grid gap-5 md:grid-cols-2">
    {
      skillGroups.map((group) => (
        <div class="panel panel-hover reveal p-5 sm:p-6">
          <div class="mb-1 flex items-baseline justify-between gap-3">
            <h3 class="display text-lg text-text">{group.title}</h3>
            <span class="font-mono text-xs text-accent">VLAN {group.vlan}</span>
          </div>
          <p class="mb-4 font-mono text-[0.7rem] tracking-wider text-muted uppercase">
            {group.source}
          </p>
          <ul class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

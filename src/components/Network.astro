---
import Section from './Section.astro';
import NetworkDiagram from './NetworkDiagram.astro';

// Principes d'architecture illustrés par la maquette — chacun s'appuie sur une
// compétence « Systèmes & réseaux » concrète.
const principles = [
  {
    title: 'Segmentation par VLAN',
    text: 'Cloisonnement des flux supervision / serveurs / clients pour limiter la surface d’attaque et le périmètre des pannes.',
  },
  {
    title: 'Pare-feu en coupure',
    text: 'pfSense en tête de réseau : règles de filtrage, NAT, VPN. Le LAN n’est jamais directement exposé à Internet.',
  },
  {
    title: 'Active Directory',
    text: 'Authentification centralisée, DNS, DHCP et stratégies de groupe (GPO) pour administrer le parc de façon homogène.',
  },
  {
    title: 'Virtualisation Proxmox',
    text: 'Isolation des rôles par VM, snapshots pour restaurer vite, densité maximale sur une seule machine physique.',
  },
  {
    title: 'Supervision & inventaire',
    text: 'Zabbix surveille, GLPI inventorie et trace les tickets — détecter l’incident avant l’appel de l’utilisateur.',
  },
  {
    title: 'Analyse de trafic',
    text: 'Wireshark en écoute sur le lien cœur : comprendre ce qui circule vraiment, diagnostiquer au paquet près.',
  },
];
---

<Section
  id="lab"
  eyebrow="laboratoire personnel · BTS systèmes numériques"
  title="Le lab derrière les compétences"
>
  <p class="reveal -mt-6 mb-10 max-w-2xl text-muted sm:text-lg">
    Les compétences réseau du CV ne sortent pas d’un manuel : elles tournent sur
    cette maquette, montée et cassée puis remontée chez moi. Voici son schéma.
  </p>

  <div class="panel reveal mb-10 overflow-x-auto p-4 sm:p-8">
    <div class="min-w-[640px]">
      <NetworkDiagram />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      principles.map((p) => (
        <div class="panel panel-hover reveal p-5">
          <h3 class="mb-2 flex items-center gap-2.5 font-mono text-sm text-text">
            <span class="inline-block h-2 w-2 flex-none rounded-full bg-accent" />
            {p.title}
          </h3>
          <p class="text-sm leading-relaxed text-muted">{p.text}</p>
        </div>
      ))
    }
  </div>
</Section>

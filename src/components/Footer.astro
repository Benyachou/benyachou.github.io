---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-3 px-4 py-8 font-mono text-xs text-muted sm:flex-row sm:items-center sm:px-6"
  >
    <p>
      © {year} {site.name} — schéma v{year}. Construit avec Astro, hébergé sur
      GitHub Pages.
    </p>
    <p class="flex items-center gap-2">
      <span class="led" aria-hidden="true"></span>
      tous les services sont opérationnels
    </p>
  </div>
</footer>

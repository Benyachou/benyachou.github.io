---
import { site } from '../data/site';
import { withBase } from '../lib/path';

const cvHref = withBase(site.cvPath);

const links = [
  { href: '#a-propos', label: 'à propos' },
  { href: '#competences', label: 'compétences' },
  { href: '#projets', label: 'projets' },
  { href: '#lab', label: 'le lab' },
  { href: '#parcours', label: 'parcours' },
  { href: '#contact', label: 'contact' },
];
---

<header
  class="sticky top-0 z-50 border-b border-line bg-ink/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
    aria-label="Navigation principale"
  >
    <a href="#hero" class="flex items-center gap-2.5" aria-label="Haut de page">
      <!-- Marque : nœud central relié, en écho à la topologie du hero. -->
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <path d="M13 13 L4 4 M13 13 L22 5 M13 13 L21 21" class="cable cable--lit"></path>
        <circle cx="4" cy="4" r="2.5" fill="#4fc3e8"></circle>
        <circle cx="22" cy="5" r="2.5" fill="#4fc3e8"></circle>
        <circle cx="21" cy="21" r="2.5" fill="#4fc3e8"></circle>
        <circle cx="13" cy="13" r="4" fill="#f4772e"></circle>
      </svg>
      <span class="display text-base text-text">Benyachou</span>
    </a>

    <!-- Liens (desktop) -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="px-3 py-2 font-mono text-[0.8rem] tracking-wide text-muted transition-colors hover:text-cable"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={cvHref}
        class="btn-primary hidden !px-3.5 !py-2 sm:inline-flex"
      >
        CV ↓
      </a>

      <!-- Bouton menu (mobile) -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center border border-line text-muted transition-colors hover:border-cable hover:text-text md:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-ink px-4 py-3 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block px-3 py-2 font-mono text-sm text-muted hover:text-cable"
              data-mobile-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a href={cvHref} class="btn-primary w-full justify-center" data-mobile-link>
          Télécharger le CV
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    // Menu mobile : ouverture/fermeture.
    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(open));
    });
    // Referme le menu après un clic sur un lien.
    document.querySelectorAll('[data-mobile-link]').forEach((el) => {
      el.addEventListener('click', () => {
        menu?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>

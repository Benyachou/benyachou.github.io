---
import '../styles/global.css';
import { site } from '../data/site';
import { withBase } from '../lib/path';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} — ${site.role}`, description = site.description } =
  Astro.props;

const favicon = withBase('favicon.svg');

// URL canonique absolue de la page courante.
const canonical = new URL(Astro.url.pathname, site.siteUrl).href;
// Carte sociale : la photo de profil, hébergée dans public/.
const ogImage = new URL(withBase('photo.png'), site.siteUrl).href;

// Données structurées JSON-LD (Person) pour le SEO.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: site.siteUrl,
  sameAs: [site.githubUrl, site.linkedinUrl],
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06131f" />

    <!-- Typographies : Archivo (titres), IBM Plex Sans / Mono (texte, labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />

    <!-- Open Graph / réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link
      rel="sitemap"
      type="application/xml"
      href={withBase('sitemap-index.xml')}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
    />
  </head>
  <body>
    <!-- Fond « papier de schéma » fixe, derrière tout le contenu. -->
    <div class="blueprint" aria-hidden="true"></div>

    <slot />

    <script is:inline>
      (() => {
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;

        // Paquets animés (SMIL) : retirés si l'utilisateur préfère moins de mouvement.
        if (reduce) {
          document.querySelectorAll('[data-packet]').forEach((el) => el.remove());
        }

        // Apparition douce des sections au scroll.
        const els = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
